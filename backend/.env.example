# Project Configuration
PROJECT_NAME="RAG Knowledge Base API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security & JWT
SECRET_KEY="replace-with-a-very-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Google Gemini)
GOOGLE_API_KEY="your-gemini-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"

# Vector Database (Local persistence fallback)
CHROMA_PERSIST_DIRECTORY="./chroma_db"
COLLECTION_NAME="rag_documents"

# Supabase Auth / Database
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Special Role Accounts (Admin & Editor)
ADMIN_EMAIL="admin@ragkb.com"
EDITOR_EMAIL="editor@ragkb.com"
ADMIN_INITIAL_PASSWORD="AdminPassword123!"
EDITOR_INITIAL_PASSWORD="EditorPassword123!"

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
